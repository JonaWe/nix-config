[Unit]
Description=ConvertX File Conversion
After=network-online.target

[Container]
Image=docker.io/c4illin/convertx:latest
ContainerName=convertx
AutoUpdate=registry
PublishPort=8317:3000

# Notify=healthy makes systemd wait for this before calling the unit
# started, which is what gives podman auto-update a failure to roll back on.
HealthCmd=curl -fsS http://127.0.0.1:3000/
HealthInterval=1m
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=1m
Notify=healthy

Environment=ALLOW_UNAUTHENTICATED=true
Environment=ACCOUNT_REGISTRATION=false
Environment=HTTP_ALLOWED=true

Volume=/opt/services/convertx/config:/app/data:Z

[Service]
Restart=always

[Install]
WantedBy=default.target
