    {
      "type": "stat",
      "title": "Sweep age",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - node_textfile_mtime_seconds{file=~\".*homelab_user_units.prom\"}",
          "refId": "A",
          "instant": true,
          "range": false
