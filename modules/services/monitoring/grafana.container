[Unit]
Description=Grafana
After=network-online.target

[Container]
Image=docker.io/grafana/grafana:13.0.1
ContainerName=grafana
Network=host

UserNS=keep-id:uid=472,gid=472

Environment=GF_SERVER_HTTP_ADDR=127.0.0.1
Environment=GF_SERVER_HTTP_PORT=3300
Environment=GF_SERVER_ROOT_URL=https://grafana.ts.pinkorca.de
Environment=GF_ANALYTICS_REPORTING_ENABLED=false
Environment=GF_ANALYTICS_CHECK_FOR_UPDATES=false
Environment=GF_PATHS_PROVISIONING=/etc/grafana/provisioning

Volume=/etc/monitoring/grafana/provisioning:/etc/grafana/provisioning:ro
Volume=/etc/monitoring/grafana/dashboards:/etc/grafana/dashboards:ro
Volume=/opt/services/monitoring/grafana/data:/var/lib/grafana:Z

[Service]
Restart=always

[Install]
WantedBy=default.target
